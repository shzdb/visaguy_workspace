+def _validate_optional_data_check(field: str, check_digit: str) -> bool:
+	"""Validate the optional-data check digit (TD3 line 2, position 43).
+
+	ICAO 9303 Part 4: when the optional-data field is unused it is filled with
+	``<``, and the check-digit position may itself carry the ``<`` filler. Some
+	issuing states write ``0`` there instead. Both are conformant, so an unused
+	field validates on either.
+
+	This relaxation applies to the optional-data field only. The four mandatory
+	check digits keep strict numeric comparison, where a filler is a genuine
+	failure.
+	"""
+	if set(field) == {"<"}:
+		return check_digit in ("<", "0")
+	value = _parse_check_digit(check_digit)
+	return value is not None and compute_icao_check_digit(field) == value
 
 
